<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sessionScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/study_background" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <com.google.android.material.card.MaterialCardView style="@style/StudioCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:id="@+id/sessionPosition" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/study_quiz" android:textSize="13sp" android:textStyle="bold" android:lineSpacingExtra="4dp"/>
                <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/sessionProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" app:trackThickness="5dp" app:trackCornerRadius="3dp" app:indicatorColor="@color/study_quiz" app:trackColor="@color/study_quiz_soft"/>
                <TextView android:id="@+id/sessionPrompt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/study_text" android:lineSpacingExtra="5dp" android:textIsSelectable="true"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <RadioGroup android:id="@+id/sessionOptions" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/sessionAnswer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:background="@drawable/study_field" android:padding="16dp" android:minHeight="140dp" android:gravity="top" android:hint="Scrivi la risposta, oppure rispondi a voce" android:textColor="@color/study_text" android:textColorHint="@color/study_muted" android:textSize="17sp" android:inputType="textMultiLine|textCapSentences"/>
        <EditText android:id="@+id/sessionNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="8dp" android:background="@drawable/study_field" android:padding="16dp" android:minHeight="72dp" android:gravity="top" android:hint="Nota sull’errore o dubbio (facoltativa)" android:textColor="@color/study_text" android:textColorHint="@color/study_muted" android:textSize="15sp" android:inputType="textMultiLine|textCapSentences"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/sessionConfirm" style="@style/StudioButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Conferma risposta"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/sessionReveal" style="@style/StudioButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mostra soluzione e criteri" app:backgroundTint="@color/study_recall"/>
        <TextView android:id="@+id/sessionFeedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="14dp" android:background="@drawable/study_feedback" android:padding="20dp" android:textColor="@color/study_text" android:textSize="17sp" android:lineSpacingExtra="6dp" android:textIsSelectable="true" android:accessibilityLiveRegion="polite"/>
        <LinearLayout android:id="@+id/sessionRatings" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="Autovalutazione: confronta la tua risposta con i criteri" android:textColor="@color/study_muted" android:textSize="15sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/ratingWrong" style="@style/StudioButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Da ripassare" app:backgroundTint="@color/study_error_soft" android:textColor="@color/study_error" app:strokeWidth="1dp" app:strokeColor="@color/study_error"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/ratingPartial" style="@style/StudioButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Parziale" app:backgroundTint="@color/study_warning_soft" android:textColor="@color/study_warning" app:strokeWidth="1dp" app:strokeColor="@color/study_warning"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/ratingCorrect" style="@style/StudioButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Corretta" app:backgroundTint="@color/study_spring_soft" android:textColor="@color/study_spring" app:strokeWidth="1dp" app:strokeColor="@color/study_spring"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/sessionSkip" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Salta: resta da ripassare" android:textColor="@color/study_muted"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/sessionNext" style="@style/StudioButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Prossima domanda"/>
        <LinearLayout android:id="@+id/sessionResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
