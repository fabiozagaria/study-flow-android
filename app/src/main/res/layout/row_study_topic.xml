<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/StudioCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" android:clickable="true" android:focusable="true" app:rippleColor="@color/study_selected">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <View android:id="@+id/topicAccent" android:layout_width="5dp" android:layout_height="match_parent" android:background="@color/study_java"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:id="@+id/topicSubject" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/study_chip" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:textSize="12sp" android:textStyle="bold"/>
                <TextView android:id="@+id/topicRead" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="12sp" android:textColor="@color/study_spring"/>
            </LinearLayout>
            <TextView android:id="@+id/topicCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/study_muted" android:textSize="12sp" android:letterSpacing="0.05"/>
            <TextView android:id="@+id/topicTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/study_text"/>
            <TextView android:id="@+id/topicInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="14sp" android:textColor="@color/study_quiz"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
