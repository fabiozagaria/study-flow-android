<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/study_background">
    <LinearLayout android:id="@+id/studyHero" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/study_hero">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="IL TUO SPAZIO DI STUDIO" android:textColor="#C5E6DD" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Capisci. Prova. Ripassa." android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Java e Spring Boot, un argomento alla volta." android:textColor="#D7EBE7" android:textSize="14sp"/>
    </LinearLayout>
    <EditText android:id="@+id/studySearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:background="@drawable/study_field" android:paddingHorizontal="16dp" android:paddingVertical="14dp" android:minHeight="50dp" android:hint="Cerca argomento o categoria" android:textColor="@color/study_text" android:textColorHint="@color/study_muted" android:textSize="15sp" android:inputType="text" android:singleLine="true"/>
    <HorizontalScrollView android:id="@+id/studyFilters" android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:layout_marginTop="6dp"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/filterAll" style="@style/StudioFilter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:text="Tutti"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/filterJava" style="@style/StudioFilter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:text="Java"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/filterSpring" style="@style/StudioFilter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:text="Spring Boot"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/filterHistory" style="@style/StudioFilter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tentativi"/>
    </LinearLayout></HorizontalScrollView>
    <LinearLayout android:id="@+id/mixedActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/mixedJava" style="@style/StudioButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="Quiz Java" app:backgroundTint="@color/study_java"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/mixedSpring" style="@style/StudioButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Quiz Spring" app:backgroundTint="@color/study_spring"/>
    </LinearLayout>
    <TextView android:id="@+id/studyCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingTop="8dp" android:paddingBottom="2dp" android:textColor="@color/study_muted" android:textSize="12sp" android:accessibilityLiveRegion="polite"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/studyTopics" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:padding="16dp"/>
    <androidx.core.widget.NestedScrollView android:id="@+id/studyDetail" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:visibility="gone"><LinearLayout android:id="@+id/studyContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"/></androidx.core.widget.NestedScrollView>
</LinearLayout>
