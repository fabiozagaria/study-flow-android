<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="4dp">
<TextView android:id="@+id/notificationPhase" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Compat.Notification.Title" android:textSize="16sp"/>
<Chronometer android:id="@+id/notificationCountdown" android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:includeFontPadding="false" android:textAppearance="@style/TextAppearance.Compat.Notification.Title" android:textSize="42sp" android:fontFamily="sans-serif-medium" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="28sp" android:autoSizeMaxTextSize="42sp" android:autoSizeStepGranularity="1sp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Compat.Notification" android:text="Il conto alla rovescia continua in background" android:textSize="13sp"/>
</LinearLayout>
