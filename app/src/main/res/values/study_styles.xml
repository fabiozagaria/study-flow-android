<resources>
    <style name="StudioCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/study_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/study_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="StudioButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="backgroundTint">@color/study_quiz</item>
        <item name="android:textColor">@color/study_surface</item>
    </style>
    <style name="StudioFilter" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/study_border</item>
        <item name="android:textColor">@color/study_muted</item>
    </style>
</resources>
